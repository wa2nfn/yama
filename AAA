	centeredAppLayout := tview.NewGrid().
		SetColumns(0, 100, 0). // Auto left-margin, 100-col center, Auto right-margin
		SetRows(0, 30, 0).     // Auto top-margin, 30-row center, Auto bottom-margin
		AddItem(mainFlex, 1, 1, 1, 1, 0, 0, true)

